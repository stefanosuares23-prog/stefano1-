<style>
:root{
--primary:#6366f1;
--secondary:#06b6d4;
--dark:#0f172a;
--card:#1e293b;
--gray:#94a3b8;
--success:#22c55e;
}

*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Inter;background:var(--dark);color:white}

nav{
position:fixed;top:0;width:100%;z-index:1000;
background:rgba(15,23,42,.95);
padding:1rem 5%;
display:flex;justify-content:space-between;align-items:center
}
nav ul{display:flex;gap:20px;list-style:none}
nav a{color:white;text-decoration:none}
nav a:hover{color:var(--secondary)}

.hero{
height:70vh;
background:linear-gradient(rgba(15,23,42,.8),rgba(15,23,42,.8)),
url('https://images.unsplash.com/photo-1518770660439-4636190af475');
background-size:cover;
display:flex;flex-direction:column;
align-items:center;justify-content:center;
text-align:center
}

.container{max-width:1200px;margin:auto;padding:90px 20px}
.title{text-align:center;color:var(--secondary);margin-bottom:40px}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:25px}

.card{
background:var(--card);
border-radius:15px;
overflow:hidden;
text-align:center
}
.card img{
width:100%;
height:180px;
object-fit:cover
}
.card div{padding:20px}

.price{
color:var(--secondary);
font-weight:bold;
margin:10px 0;
font-size:1.1rem
}

.btn{
display:inline-block;
margin-top:10px;
background:var(--primary);
color:white;
padding:10px 15px;
border-radius:8px;
text-decoration:none;
font-weight:bold
}

.whatsapp{
position:fixed;bottom:20px;right:20px;
background:var(--success);color:white;
width:60px;height:60px;
border-radius:50%;
display:flex;align-items:center;justify-content:center;
font-size:28px;text-decoration:none
}

input,textarea{
width:100%;
padding:15px;
border:none;border-radius:8px;
background:#334155;color:white
}

footer{
background:#020617;
padding:40px;
text-align:center;color:var(--gray)
}
</style>
</head>

